@page "/support-list"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<h3>Supporthenvendelser</h3>

<label for="categoryFilter">Kategori:</label>
<select id="categoryFilter" @onchange="ChangeCategory">
    <option value="">Alle</option>
    <option value="Reservedele">Reservedele</option>
    <option value="Reparation">Reparation</option>
    <option value="Support">Support</option>
</select>

@if (supportMessages.Count == 0)
{
    <p>Ingen henvendelser fundet.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Navn</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Kategori</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var message in supportMessages)
        {
            <tr>
                <td>@message.ContactName</td>
                <td>@message.Email</td>
                <td>@message.Phone</td>
                <td>@message.Category</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage> supportMessages = new();

    protected override async Task OnInitializedAsync()
    {
        supportMessages = await CosmosDbService.GetSupportMessagesAsync();
    }
    
    private async Task ChangeCategory(ChangeEventArgs e)
    {
        var category = e.Value?.ToString() ?? "";

        if (string.IsNullOrEmpty(category))
        {
            supportMessages = await CosmosDbService.GetSupportMessagesAsync();
        }
        else
        {
            supportMessages =
                await CosmosDbService.GetSupportMsgByCategoryAsync(category);
        }
    }
}